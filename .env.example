# ================================================================
# NEXUS AI — Environment Variables
# ================================================================
# Copy this file to .env and fill in real values before running.
#
# Required vars are marked  ← REQUIRED
# Optional vars show their default in parentheses
# Docker Compose auto-fills DATABASE_URL and REDIS_URL when using
# `docker-compose up` — only set them for local bare-metal runs.
# ================================================================


# ──────────────────────────────────────────────────────────────
# AI — Claude (Anthropic)
# ──────────────────────────────────────────────────────────────
# ← REQUIRED: get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Claude model to use (default: claude-sonnet-4-5)
# Other options: claude-3-haiku-20240307, claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-sonnet-4-5


# ──────────────────────────────────────────────────────────────
# Auth / JWT
# ──────────────────────────────────────────────────────────────
# ← REQUIRED in production: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-in-production

# Algorithm used to sign tokens (default: HS256)
JWT_ALGORITHM=HS256

# Token lifetime in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440


# ──────────────────────────────────────────────────────────────
# Database — PostgreSQL
# ──────────────────────────────────────────────────────────────
# Docker Compose sets this automatically via service name.
# Only set this for bare-metal / local runs outside Docker.
DATABASE_URL=postgresql+asyncpg://nexus:nexuspass@localhost:5432/nexus

# Postgres credentials used by the postgres Docker service
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexuspass


# ──────────────────────────────────────────────────────────────
# Cache — Redis
# ──────────────────────────────────────────────────────────────
# Docker Compose sets this automatically via service name.
# Only set this for bare-metal / local runs outside Docker.
REDIS_URL=redis://localhost:6379/0


# ──────────────────────────────────────────────────────────────
# F05 — Collective Memory (Pinecone vector store)
# ──────────────────────────────────────────────────────────────
# Optional — if left empty, F05 is silently disabled at startup.
# The bot still works fully; it just won't use cross-session memory.
#
# Get a free API key at: https://app.pinecone.io
# The index will be auto-created on first run if it doesn't exist.
PINECONE_API_KEY=
PINECONE_INDEX=nexus-collective


# ──────────────────────────────────────────────────────────────
# F06 — Trust Engine debit rules (points lost per failure type)
# ──────────────────────────────────────────────────────────────
TRUST_DEBIT_ESCALATION=20      # escalation to human agent
TRUST_DEBIT_UNRESOLVED=10      # unresolved after 3 turns
TRUST_DEBIT_LONG_WAIT=5        # response wait > 2 minutes
TRUST_STARTING_BALANCE=100     # every new customer starts here


# ──────────────────────────────────────────────────────────────
# App / Server
# ──────────────────────────────────────────────────────────────
APP_NAME=Nexus AI

# Set to true only in local development — never in production
DEBUG=false

# Comma-separated list of allowed CORS origins
# Docker Compose frontend runs on 5173; nginx proxy on 80
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# Path to the trained silence-detection model artifact.
# Auto-resolved relative to the backend package if not set.
# On a fresh clone, train_if_missing() creates this file at startup.
# Override for Docker volume mounts or custom artifact locations.
MODEL_PATH=app/models/silence_model.joblib


# ──────────────────────────────────────────────────────────────
# Frontend (Vite) — only needed when running frontend standalone
# ──────────────────────────────────────────────────────────────
# When using Docker Compose these are set in docker-compose.yml.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
